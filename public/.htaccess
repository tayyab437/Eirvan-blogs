# ==============================================================================
# EIRVAN BLOGS — Production Apache Configuration (.htaccess)
# Optimized for IONOS Web Hosting Plus & Apache 2.4+
# ==============================================================================

# 1. Single Page Application (SPA) URL Rewrites
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to .well-known directory (ARD manifests, SSL challenges, LLMs.txt)
  RewriteRule ^\.well-known/ - [L]

  # If the requested filename exists as a real file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other requests (e.g. /article/*, /category/*, /author/*, /admin, /about) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 2. Production Security Headers
<IfModule mod_headers.c>
  # Prevent browsers from MIME-sniffing away from the declared content-type
  Header always set X-Content-Type-Options "nosniff"

  # Enforce privacy and referrer origin integrity on cross-domain requests
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict browser hardware APIs not utilized by the publication
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content-Security-Policy (CSP)
  # Permits Google Fonts, Unsplash CDN, Firebase Authentication, Cloud Firestore, and Google APIs
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://apis.google.com https://www.gstatic.com https://gen-lang-client-0804123492.firebaseapp.com https://*.firebaseapp.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://*.googleusercontent.com; connect-src 'self' https://firestore.googleapis.com https://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://gen-lang-client-0804123492.firebaseapp.com https://www.googleapis.com https://apis.google.com; frame-src 'self' https://gen-lang-client-0804123492.firebaseapp.com https://*.firebaseapp.com; object-src 'none'; base-uri 'self';"

  # Allow Cross-Origin Resource Sharing for machine discovery manifests
  <FilesMatch "\.(json|xml|txt)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # HTML documents must revalidate immediately to guarantee updated releases
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Service Worker and manifest caching control
  <FilesMatch "(sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Long-term immutable caching for static hashed assets (JS, CSS, WebP, fonts)
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|ico|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# 3. MIME Type Declarations
<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType application/rss+xml .xml
  AddType text/markdown .txt
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

# 4. Gzip & Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

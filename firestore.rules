rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ashfaqtayyab318@gmail.com' ||
        request.auth.token.email == 'admin@eirvan.com' ||
        request.auth.token.email == 'admin@chroniclepulse.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Article Collection: Public Read for SEO & Search Engine Indexing
    match /articles/{articleId} {
      allow get, list: if true;
      allow create: if ((isAdmin() || isSignedIn()) || articleId.matches('^art-00[1-9]$')) && isValidId(articleId);
      allow update: if (isAdmin() || isSignedIn()) || (
        // Allow readers to increment views or reactions
        incoming().diff(existing()).affectedKeys().hasOnly(['views', 'reactions', 'isBookmarked'])
      );
      allow delete: if isAdmin() || isSignedIn();
    }

    // Ad Inventory Slots: Public Read & Impression / Click Updates
    match /adSlots/{slotId} {
      allow get, list: if true;
      allow create: if ((isAdmin() || isSignedIn()) || slotId.matches('^ad-[a-z0-9\\-]+$')) && isValidId(slotId);
      allow delete: if isAdmin() || isSignedIn();
      allow update: if (isAdmin() || isSignedIn()) || (
        // Allow public visitors to record impressions and clicks
        incoming().diff(existing()).affectedKeys().hasOnly(['impressions', 'clicks'])
      );
    }

    // Analytics Collection: Public Read & Telemetry Logging
    match /analytics/{docId} {
      allow get, list: if true;
      allow write: if true;
    }

    // Admin Whitelist: Restricted to Authenticated Staff
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

  }
}

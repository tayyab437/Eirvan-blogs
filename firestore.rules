rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ashfaqtayyab318@gmail.com' ||
        request.auth.token.email == 'admin@eirvan.com' ||
        request.auth.token.email == 'admin@chroniclepulse.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Article Collection: Public Read for SEO & Search Engine Indexing
    match /articles/{articleId} {
      allow get, list: if true;
      allow create: if (isAdmin() || (!exists(/databases/$(database)/documents/articles/$(articleId)) && articleId.matches('^art-00[1-9]$'))) && isValidId(articleId);
      allow update: if isAdmin() || (
        // Allow readers to increment views, bookmarks, or reactions only
        incoming().diff(existing()).affectedKeys().hasOnly(['views', 'reactions', 'isBookmarked'])
      );
      allow delete: if isAdmin();
    }

    // Ad Inventory Slots: Public Read & Impression / Click Updates
    match /adSlots/{slotId} {
      allow get, list: if true;
      allow create: if (isAdmin() || (!exists(/databases/$(database)/documents/adSlots/$(slotId)) && slotId.matches('^ad-[a-z0-9\\-]+$'))) && isValidId(slotId);
      allow update: if isAdmin() || (
        // Allow public visitors to record impressions and clicks only
        incoming().diff(existing()).affectedKeys().hasOnly(['impressions', 'clicks'])
      );
      allow delete: if isAdmin();
    }

    // Analytics Collection: Public Read & Telemetry Logging
    match /analytics/{docId} {
      allow get, list: if true;
      allow create: if (isAdmin() || (!exists(/databases/$(database)/documents/analytics/$(docId)) && isValidId(docId)));
      allow update: if isAdmin() || (
        // Allow public telemetry to update aggregate counts only
        incoming().diff(existing()).affectedKeys().hasOnly(['totalPageviews', 'lastUpdated', 'activeVisitors', 'impressions', 'clicks'])
      );
      allow delete: if isAdmin();
    }

    // Admin Whitelist: Restricted strictly to Authenticated Admins
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

  }
}


{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Editorial article entity containing publication content, workflow status, citations, SEO metadata, and engagement statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 256 },
        "title": { "type": "string", "maxLength": 300 },
        "metaTitle": { "type": "string", "maxLength": 300 },
        "metaDescription": { "type": "string", "maxLength": 1000 },
        "canonicalUrl": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 },
        "tags": { "type": "array", "description": "Array of topical tag strings" },
        "author": { "type": "object", "description": "Author profile" },
        "reviewer": { "type": "object", "description": "Subject-matter reviewer attribution" },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "scheduledAt": { "type": "string", "maxLength": 64 },
        "readTimeMinutes": { "type": "number" },
        "featuredImage": { "type": "string", "maxLength": 1000 },
        "socialImage": { "type": "string", "maxLength": 1000 },
        "imageAlt": { "type": "string", "maxLength": 500 },
        "summary": { "type": "string", "maxLength": 2000 },
        "contentHtml": { "type": "string", "maxLength": 100000 },
        "headings": { "type": "array", "description": "Heading list for TOC" },
        "faqs": { "type": "array", "description": "FAQ list for visible accordion & FAQPage JSON-LD" },
        "sources": { "type": "array", "description": "Verified primary sources and citations" },
        "relatedArticleIds": { "type": "array", "description": "Curated related article IDs" },
        "pillarId": { "type": "string", "maxLength": 128 },
        "topicCluster": { "type": "string", "maxLength": 200 },
        "previousSlugs": { "type": "array", "description": "Historical slugs for 301 redirect mapping" },
        "focusTopic": { "type": "string", "maxLength": 200 },
        "secondaryTopics": { "type": "array" },
        "searchIntent": { "type": "string", "enum": ["informational", "commercial", "transactional", "navigational"] },
        "articleType": { "type": "string", "enum": ["Article", "BlogPosting", "NewsArticle"] },
        "robotsDirective": { "type": "string", "enum": ["index, follow", "noindex, follow"] },
        "aiAssisted": { "type": "boolean" },
        "humanReviewed": { "type": "boolean" },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "reviewedRevisionHash": { "type": "string", "maxLength": 64 },
        "approval": { "type": "object", "description": "Revision-bound authorized reviewer approval metadata" },
        "editorialNotes": { "type": "string", "maxLength": 2000 },
        "changelog": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "in_review", "approved", "scheduled", "published", "archived"] },
        "targetKeywords": { "type": "array" },
        "views": { "type": "number" },
        "reactions": { "type": "object" },
        "isBookmarked": { "type": "boolean" }
      },
      "required": ["id", "slug", "title", "category", "status"]
    },
    "PublicAdSlot": {
      "title": "PublicAdSlot",
      "description": "Public advertising creative configuration stored in /adSlots (zero private performance metrics)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["leaderboard", "rectangle", "native-card", "in-article"] },
        "dimensions": { "type": "string", "maxLength": 100 },
        "sponsorName": { "type": "string", "maxLength": 200 },
        "headline": { "type": "string", "maxLength": 300 },
        "tagline": { "type": "string", "maxLength": 500 },
        "ctaText": { "type": "string", "maxLength": 100 },
        "ctaUrl": { "type": "string", "maxLength": 1000 },
        "badgeLabel": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "isEnabled": { "type": "boolean" }
      },
      "required": ["id", "name", "type", "dimensions", "sponsorName", "headline", "tagline", "ctaText", "ctaUrl", "badgeLabel", "isEnabled"]
    },
    "AdMetrics": {
      "title": "AdMetrics",
      "description": "Private advertising performance metrics and tracking isolated in /adMetrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" },
        "impressionsStatus": { "type": "string", "enum": ["actual", "missing"] },
        "clicksStatus": { "type": "string", "enum": ["actual", "missing"] },
        "revenue": { "type": "number" },
        "revenueStatus": { "type": "string", "enum": ["actual", "missing"] },
        "estimatedRevenue": { "type": "number" },
        "revenueEstimateStatus": { "type": "string", "enum": ["estimated"] },
        "revenueEstimateFormula": { "type": "string", "maxLength": 200 },
        "ctr": { "type": "number" },
        "campaignPerformance": { "type": "object" },
        "internalTracking": { "type": "string" },
        "legacyExtraFields": { "type": "object" },
        "migratedFromLegacy": { "type": "boolean" },
        "archivedToSubcollection": { "type": "boolean" },
        "archivedFields": { "type": "array" },
        "archiveChunkCount": { "type": "number" },
        "archiveChecksumSha256": { "type": "string", "maxLength": 128 },
        "lastUpdated": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "impressionsStatus", "clicksStatus", "revenueStatus"]
    },
    "AdMetricsArchiveChunk": {
      "title": "AdMetricsArchiveChunk",
      "description": "Chunked overflow archive record for oversized legacy ad metric payloads",
      "type": "object",
      "properties": {
        "slotId": { "type": "string", "maxLength": 128 },
        "chunkIndex": { "type": "number" },
        "chunkCount": { "type": "number" },
        "payloadChunk": { "type": "string", "maxLength": 921600 },
        "checksumSha256": { "type": "string", "maxLength": 128 },
        "archivedFields": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["slotId", "chunkIndex", "chunkCount", "payloadChunk", "checksumSha256"]
    },
    "SiteAnalytics": {
      "title": "SiteAnalytics",
      "description": "Visitor behavior telemetry metrics and estimated earnings",
      "type": "object",
      "properties": {
        "totalPageviews": { "type": "number" },
        "uniqueSessions": { "type": "number" },
        "avgDwellSeconds": { "type": "number" },
        "scrollMilestones": { "type": "object" },
        "topQueries": { "type": "array" },
        "dailyViews": { "type": "array" },
        "adImpressions": { "type": "number" },
        "adClicks": { "type": "number" },
        "estimatedEarnings": { "type": "number" }
      }
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Designated administrator identity record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin", "editor"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "ArticlePrivateNote": {
      "title": "ArticlePrivateNote",
      "description": "Private admin-only editorial review notes separated from public published article documents",
      "type": "object",
      "properties": {
        "articleId": { "type": "string", "maxLength": 128 },
        "editorialNotes": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["articleId"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of all publication articles and briefings"
    },
    "/articlePrivate/{articleId}": {
      "schema": "ArticlePrivateNote",
      "description": "Private admin-only editorial review notes excluded from published article documents"
    },
    "/adSlots/{slotId}": {
      "schema": "PublicAdSlot",
      "description": "Collection of public monetization ad inventory creative slots (strictly allowlisted)"
    },
    "/adMetrics/{slotId}": {
      "schema": "AdMetrics",
      "description": "Private admin-only advertising performance metrics"
    },
    "/adMetricsArchive/{slotId}/chunks/{chunkId}": {
      "schema": "AdMetricsArchiveChunk",
      "description": "Private admin-only chunked archive for oversized legacy ad metrics payloads"
    },
    "/analytics/{analyticsId}": {
      "schema": "SiteAnalytics",
      "description": "Aggregated site visitor telemetry"
    },
    "/admins/{adminId}": {
      "schema": "AdminProfile",
      "description": "Authorized administrator whitelist collection"
    }
  }
}

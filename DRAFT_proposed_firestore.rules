rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasTokenEmail() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email is string;
    }

    function isSuperAdmin() {
      return isEmailVerified()
        && hasTokenEmail()
        && request.auth.token.email.lower() == 'ashfaqtayyab318@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isEmailVerified() && (
          request.auth.token.admin == true ||
          (hasTokenEmail() && request.auth.token.email.lower() in ['ashfaqtayyab318@gmail.com', 'admin@eirvan.com', 'admin@chroniclepulse.com']) ||
          (
            hasTokenEmail() &&
            exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email is string &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email.lower() == request.auth.token.email.lower()
          )
        )
      );
    }

    // Detects unmigrated legacy / unapproved fields on an existing /adSlots document
    function hasLegacyAdFields(data) {
      return data.keys().hasAny([
          'impressions',
          'clicks',
          'revenue',
          'ctr',
          'campaignPerformance',
          'internalTracking',
          'lastUpdated'
        ])
        || !data.keys().hasOnly([
          'id',
          'name',
          'type',
          'dimensions',
          'sponsorName',
          'headline',
          'tagline',
          'ctaText',
          'ctaUrl',
          'badgeLabel',
          'imageUrl',
          'isEnabled'
        ]);
    }

    // Server-side migration guard: refuses overwriting any /adSlots document until legacy fields
    // are scrubbed AND its corresponding private /adMetrics/{slotId} record exists.
    function isAdSlotMigrated(slotId) {
      return !hasLegacyAdFields(existing())
        && exists(/databases/$(database)/documents/adMetrics/$(slotId));
    }

    // Strict Schema Allowlist Derived Directly From PublicAdSlot Interface (src/types/blog.ts)
    // Explicitly excludes impressions, clicks, revenue, ctr, campaignPerformance, internalTracking, or any unapproved fields.
    function isValidPublicAdSlot(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'type',
          'dimensions',
          'sponsorName',
          'headline',
          'tagline',
          'ctaText',
          'ctaUrl',
          'badgeLabel',
          'isEnabled'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'type',
          'dimensions',
          'sponsorName',
          'headline',
          'tagline',
          'ctaText',
          'ctaUrl',
          'badgeLabel',
          'imageUrl',
          'isEnabled'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.type in ['leaderboard', 'rectangle', 'native-card', 'in-article']
        && data.dimensions is string && data.dimensions.size() <= 100
        && data.sponsorName is string && data.sponsorName.size() <= 200
        && data.headline is string && data.headline.size() <= 300
        && data.tagline is string && data.tagline.size() <= 500
        && data.ctaText is string && data.ctaText.size() <= 100
        && data.ctaUrl is string && data.ctaUrl.size() <= 1000
        && data.badgeLabel is string && data.badgeLabel.size() <= 100
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && data.isEnabled is bool;
    }

    function isAuthorizedReviewerForApproval(approval) {
      return isEmailVerified()
        && approval.reviewerEmail is string
        && approval.reviewerUid is string
        && (
          (approval.reviewerUid == request.auth.uid && request.auth.token.admin == true) ||
          approval.reviewerEmail.lower() in ['ashfaqtayyab318@gmail.com', 'admin@eirvan.com', 'admin@chroniclepulse.com'] ||
          (
            exists(/databases/$(database)/documents/admins/$(approval.reviewerUid)) &&
            get(/databases/$(database)/documents/admins/$(approval.reviewerUid)).data.email is string &&
            get(/databases/$(database)/documents/admins/$(approval.reviewerUid)).data.email.lower() == approval.reviewerEmail.lower()
          )
        );
    }

    function hasValidEditorialApproval(data) {
      return data.humanReviewed == true
        && 'reviewedAt' in data
        && data.reviewedAt is string && data.reviewedAt.size() > 0 && data.reviewedAt.size() <= 64
        && 'reviewedRevisionHash' in data
        && data.reviewedRevisionHash is string && data.reviewedRevisionHash.size() == 64
        && 'approval' in data
        && data.approval is map
        && data.approval.reviewerUid is string && data.approval.reviewerUid.size() >= 4
        && data.approval.reviewerEmail is string
        && isAuthorizedReviewerForApproval(data.approval)
        && data.approval.reviewerName is string && data.approval.reviewerName.size() > 0
        && !(data.approval.reviewerName in ['EIRVAN Editorial Desk', 'Editorial Desk', 'Admin', 'System', 'Anonymous'])
        && data.approval.reviewedAt == data.reviewedAt
        && data.approval.reviewedRevisionHash == data.reviewedRevisionHash
        && (!('reviewer' in data) || (
          data.reviewer is map &&
          (!('email' in data.reviewer) || (data.reviewer.email is string && data.reviewer.email.lower() == data.approval.reviewerEmail.lower())) &&
          (!('uid' in data.reviewer) || data.reviewer.uid == data.approval.reviewerUid) &&
          (!('name' in data.reviewer) || data.reviewer.name == data.approval.reviewerName)
        ))
        && data.sources is list && data.sources.size() > 0;
    }

    function approvalSignerMatchesCaller(data) {
      return hasTokenEmail()
        && data.approval.reviewerEmail is string
        && data.approval.reviewerUid == request.auth.uid
        && data.approval.reviewerEmail.lower() == request.auth.token.email.lower();
    }

    function hasSubstantiveArticleChanges() {
      return incoming().diff(existing()).affectedKeys().hasAny([
        'title',
        'slug',
        'metaTitle',
        'metaDescription',
        'summary',
        'contentHtml',
        'category',
        'topicCluster',
        'articleType',
        'tags',
        'headings',
        'faqs',
        'sources',
        'author',
        'featuredImage',
        'socialImage',
        'imageAlt',
        'robotsDirective',
        'aiAssisted',
        'publishedAt',
        'scheduledAt',
        'previousSlugs'
      ]);
    }

    function isValidPublicArticleViewIncrement() {
      return existing().status == 'published'
        && incoming().diff(existing()).affectedKeys().hasOnly(['views'])
        && incoming().views is int
        && (
          ((!('views' in existing()) || existing().views == null) && incoming().views == 1) ||
          (existing().views is number && existing().views >= 0 && incoming().views == existing().views + 1)
        );
    }

    // Article Collection: Unauthenticated readers may query/read published articles only; drafts/review/scheduled/archived remain Admin-only.
    // Unauthenticated visitors may ONLY increment the numeric `views` counter by +1 on published articles.
    // Articles must NEVER carry private editorialNotes (kept strictly in /articlePrivate/{id}).
    // Any substantive edit to approved/scheduled/published content requires fresh authenticated reviewer sign-off rather than keeping prior approval.
    match /articles/{articleId} {
      allow get, list: if (resource.data.status == 'published') || isAdmin();
      allow create: if isAdmin()
        && isValidId(articleId)
        && !('editorialNotes' in incoming())
        && (
          !(incoming().status in ['approved', 'scheduled', 'published']) ||
          (hasValidEditorialApproval(incoming()) && approvalSignerMatchesCaller(incoming()))
        );
      allow update: if isValidId(articleId) && (
        isValidPublicArticleViewIncrement() ||
        (
          isAdmin()
          && !('editorialNotes' in incoming())
          && (
            !(incoming().status in ['approved', 'scheduled', 'published']) ||
            (
              hasValidEditorialApproval(incoming()) &&
              (
                (
                  !hasSubstantiveArticleChanges() &&
                  'approval' in existing() &&
                  incoming().approval == existing().approval
                ) ||
                (
                  approvalSignerMatchesCaller(incoming()) &&
                  (
                    !('reviewedRevisionHash' in existing()) ||
                    incoming().reviewedRevisionHash != existing().reviewedRevisionHash ||
                    incoming().reviewedAt != existing().reviewedAt
                  )
                )
              )
            )
          )
        )
      );
      allow delete: if isAdmin() && isValidId(articleId);
    }

    // Private Editorial Notes & Internal Review Memos: Admin Only Read & Write.
    match /articlePrivate/{articleId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(articleId);
    }

    // Ad Inventory Configuration (Public Creative Data):
    // - Public read for display (post-migration only).
    // - Create requires verified Admin + strict 12-field PublicAdSlot allowlist.
    // - Update additionally enforces isAdSlotMigrated(slotId) so unmigrated docs cannot be overwritten.
    // - Delete blocks deleting documents that still hold unmigrated legacy fields.
    match /adSlots/{slotId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(slotId) && isValidPublicAdSlot(incoming());
      allow update: if isAdmin() && isValidId(slotId) && isValidPublicAdSlot(incoming()) && isAdSlotMigrated(slotId);
      allow delete: if isAdmin() && isValidId(slotId) && !hasLegacyAdFields(existing());
    }

    // Ad Inventory Metrics (Private Performance Data): Admin Only Read & Write.
    match /adMetrics/{slotId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(slotId);
    }

    // Overflow Archive for Oversized Legacy Metric Payloads: Admin Only Read & Write.
    match /adMetricsArchive/{slotId}/{document=**} {
      allow read, write: if isAdmin() && isValidId(slotId);
    }

    // Analytics Collection: Admin Only Read & Write for Privacy & Telemetry Protection.
    match /analytics/{docId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(docId);
    }

    // Admin Whitelist: Read restricted to verified Admins. Client writes strictly prohibited.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

  }
}
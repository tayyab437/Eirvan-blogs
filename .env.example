# GEMINI_API_KEY: Required only for local/AI Studio server-side outline drafting in dev (server.ts).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Local/preview application URL.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Leave empty for static IONOS hosting.
VITE_API_BASE_URL=""

# VITE_GA_MEASUREMENT_ID: Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When unset, zero third-party analytics scripts are loaded.
VITE_GA_MEASUREMENT_ID=""

# VITE_GSC_VERIFICATION_TOKEN: Optional Google Search Console HTML meta verification token.
# Injected into <head> during npm run build when set.
VITE_GSC_VERIFICATION_TOKEN=""
